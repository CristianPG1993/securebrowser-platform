    {
      "name": "Modificar Policy ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La política confirma los cambios y conserva el contrato', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('adminPolicyId')));",
              "    pm.expect(body.name).to.eql('Política demo verificada');",
              "    pm.expect(body.urlFilteringEnabled).to.eql(true);",
              "    pm.expect(body.urlFilteringMode).to.eql('DENYLIST');",
              "    pm.expect(body.urlRules).to.eql(['blocked.example', 'phishing.example']);",
              "    pm.expect(body.downloadControlEnabled).to.eql(true);",
              "    pm.expect(body.downloadControlMode).to.eql('DENYLIST');",
              "    pm.expect(body.downloadRules).to.eql(['bat', 'exe']);",
              "});"
            ]
          }
        }
      ],
