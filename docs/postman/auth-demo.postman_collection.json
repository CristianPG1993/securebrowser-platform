        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Política demo verificada\",\n  \"urlFilteringEnabled\": true,\n  \"urlFilteringMode\": \"DENYLIST\",\n  \"urlRules\": [\n    \"BLOCKED.EXAMPLE.\",\n    \"phishing.example\"\n  ],\n  \"downloadControlEnabled\": true,\n  \"downloadControlMode\": \"DENYLIST\",\n  \"downloadRules\": [\n    \".EXE\",\n    \"bat\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/policies/{{adminPolicyId}}"
      }
    },
