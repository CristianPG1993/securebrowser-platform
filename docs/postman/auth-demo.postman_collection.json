              "    const body = pm.response.json();",
              "    pm.expect(Object.keys(body).sort()).to.eql(['id', 'companyId', 'name', 'urlFilteringEnabled', 'urlFilteringMode', 'urlRules', 'downloadControlEnabled', 'downloadControlMode', 'downloadRules', 'createdAt', 'updatedAt'].sort());",
              "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('adminPolicyId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
