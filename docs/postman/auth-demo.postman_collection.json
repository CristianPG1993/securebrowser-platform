    },
    {
      "key": "userDeviceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoEventUuid",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoEventOccurredAt",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoEventReceivedAt",
