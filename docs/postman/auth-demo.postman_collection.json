    {
      "name": "Verificar lastSeenAt de la instalación USER",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La comunicación autorizada ha registrado lastSeenAt', function () {",
              "    pm.response.to.have.status(200);",
              "    const device = pm.response.json().items.find(d => d.id === Number(pm.collectionVariables.get('userDeviceId')));",
              "    pm.expect(device).to.be.an('object');",
              "    pm.expect(device.lastSeenAt).to.be.a('string').and.not.empty;",
