    {
      "name": "Perfil USER",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Devuelve el perfil propio y el rol actual', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.role).to.eql('USER');",
              "    pm.expect(body.email).to.eql('user@demo.local');",
              "    pm.expect(Object.keys(body).sort()).to.eql(['id', 'companyId', 'name', 'lastName', 'email', 'role', 'createdAt', 'updatedAt'].sort());",
              "    pm.collectionVariables.set('userProfileId', body.id);",
