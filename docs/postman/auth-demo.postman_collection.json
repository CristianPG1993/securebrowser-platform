    {
      "name": "Listar Device propios USER",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('USER solo lista sus instalaciones activas y conserva el contrato', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.items).to.be.an('array').and.not.empty;",
              "    body.items.forEach(d => {",
              "        pm.expect(d.userId).to.eql(Number(pm.collectionVariables.get('userProfileId')));",
              "        pm.expect(d.companyId).to.eql(Number(pm.collectionVariables.get('demoCompanyId')));",
              "        pm.expect(d.active).to.eql(true);",
              "        pm.expect(Object.keys(d).sort()).to.eql(['id', 'deviceIdentifier', 'name', 'companyId', 'userId', 'licenseId', 'policyId', 'enrollmentTokenId', 'active', 'createdAt', 'updatedAt', 'lastSeenAt'].sort());",
              "    });",
              "    const demo = body.items.find(d => d.deviceIdentifier === 'b7eacb45-4aba-4a5a-8c0c-633a61294af1');",
              "    pm.expect(demo).to.be.an('object');",
              "    pm.collectionVariables.set('userDeviceId', demo.id);",
              "});"
            ]
