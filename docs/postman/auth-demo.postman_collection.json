        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          }
        ],
        "url": "{{baseUrl}}/policies?size=100"
      }
    },
    {
      "name": "Consultar Policy ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Devuelve únicamente los campos públicos de la política', function () {",
