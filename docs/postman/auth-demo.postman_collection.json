{
  "info": {
    "name": "SBP — Autenticación, Policy, Device y SecurityEvent (bloques 1–4)",
    "description": "Ejecuta en orden contra el perfil demo. Define demoAdminPassword y demoUserPassword en un entorno local, sin exportar secretos. Recorrido ADMIN login → modifica Policy → USER login → consulta Device/Policy → envía SecurityEvent → ADMIN consulta el evento. Comprueba reenvíos idénticos, conflictos, aislamiento y cierre de los grupos de renovación. El UUID de prueba se genera en cada ejecución.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080/api/v1"
    },
    {
      "key": "demoAdminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoUserPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPolicyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoCompanyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userProfileId",
      "value": "",
