{
  "info": {
    "name": "SBP — Autenticación, Policy y Device (bloques 1–3)",
    "description": "Ejecuta en orden contra el perfil demo con baseUrl y las dos contraseñas en un entorno local. ADMIN modifica Policy y consulta el catálogo de dispositivos; USER lista sus instalaciones y obtiene la Policy modificada. Comprueba propiedad, actividad, validación y autenticación. Los scripts guardan IDs y tokens por separado; el archivo no contiene secretos reales. SecurityEvent se incorporará en el bloque 4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080/api/v1"
    },
    {
      "key": "demoAdminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoUserPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPolicyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoCompanyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userProfileId",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoDeviceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userDeviceId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Login ADMIN",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const password = pm.variables.get('demoAdminPassword');",
              "if (!password) { throw new Error('Define la contraseña demo en el entorno local de Postman.'); }",
              "pm.variables.set('loginBody', JSON.stringify({email: 'admin@demo.local', password: password}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 y entrega el contrato de tokens', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(Object.keys(body).sort()).to.eql(['accessToken', 'expiresIn', 'refreshToken', 'tokenType'].sort());",
              "    pm.expect(body.tokenType).to.eql('Bearer');",
              "    pm.expect(body.expiresIn).to.be.above(0);",
              "    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "    pm.expect(body.refreshToken).to.match(/^[A-Za-z0-9_-]{43}$/);",
              "    pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
              "    pm.expect(pm.response.headers.get('Pragma')).to.eql('no-cache');",
              "    pm.collectionVariables.set('adminAccessToken', body.accessToken);",
              "    pm.collectionVariables.set('adminRefreshToken', body.refreshToken);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{loginBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Perfil ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Devuelve el perfil propio y el rol actual', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.role).to.eql('ADMIN');",
              "    pm.expect(body.email).to.eql('admin@demo.local');",
              "    pm.expect(Object.keys(body).sort()).to.eql(['id', 'companyId', 'name', 'lastName', 'email', 'role', 'createdAt', 'updatedAt'].sort());",
              "    pm.collectionVariables.set('demoCompanyId', body.companyId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users/me"
      }
    },
    {
      "name": "Listar Policy ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Lista políticas propias y selecciona la política demo', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(Object.keys(body).sort()).to.eql(['items', 'page', 'size', 'totalElements', 'totalPages'].sort());",
              "    pm.expect(body.items).to.be.an('array').and.not.empty;",
              "    pm.expect(body.page).to.eql(0);",
              "    pm.expect(body.size).to.eql(100);",
              "    pm.collectionVariables.set('adminPolicyId', body.items[0].id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          }
        ],
        "url": "{{baseUrl}}/policies?size=100"
      }
    },
    {
      "name": "Consultar Policy ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Devuelve únicamente los campos públicos de la política', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(Object.keys(body).sort()).to.eql(['id', 'companyId', 'name', 'urlFilteringEnabled', 'urlFilteringMode', 'urlRules', 'downloadControlEnabled', 'downloadControlMode', 'downloadRules', 'createdAt', 'updatedAt'].sort());",
              "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('adminPolicyId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          }
        ],
        "url": "{{baseUrl}}/policies/{{adminPolicyId}}"
      }
    },
    {
      "name": "Modificar Policy ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La política confirma los cambios y conserva el contrato', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('adminPolicyId')));",
              "    pm.expect(body.name).to.eql('Política demo verificada');",
              "    pm.expect(body.urlFilteringEnabled).to.eql(true);",
              "    pm.expect(body.urlFilteringMode).to.eql('DENYLIST');",
              "    pm.expect(body.urlRules).to.eql(['blocked.example', 'phishing.example']);",
              "    pm.expect(body.downloadControlEnabled).to.eql(true);",
              "    pm.expect(body.downloadControlMode).to.eql('DENYLIST');",
              "    pm.expect(body.downloadRules).to.eql(['bat', 'exe']);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Política demo verificada\",\n  \"urlFilteringEnabled\": true,\n  \"urlFilteringMode\": \"DENYLIST\",\n  \"urlRules\": [\n    \"BLOCKED.EXAMPLE.\",\n    \"phishing.example\"\n  ],\n  \"downloadControlEnabled\": true,\n  \"downloadControlMode\": \"DENYLIST\",\n  \"downloadRules\": [\n    \".EXE\",\n    \"bat\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/policies/{{adminPolicyId}}"
      }
    },
    {
      "name": "Rechazar PATCH Policy inválido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rechaza reglas duplicadas tras normalizar', function () {",
              "    pm.response.to.have.status(400);",
              "    pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"No debe guardarse\",\n  \"downloadRules\": [\n    \".EXE\",\n    \"exe\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/policies/{{adminPolicyId}}"
      }
    },
    {
      "name": "Verificar Policy confirmada y rechazo sin cambios",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La política confirma los cambios y conserva el contrato', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('adminPolicyId')));",
              "    pm.expect(body.name).to.eql('Política demo verificada');",
              "    pm.expect(body.urlFilteringEnabled).to.eql(true);",
              "    pm.expect(body.urlFilteringMode).to.eql('DENYLIST');",
              "    pm.expect(body.urlRules).to.eql(['blocked.example', 'phishing.example']);",
              "    pm.expect(body.downloadControlEnabled).to.eql(true);",
              "    pm.expect(body.downloadControlMode).to.eql('DENYLIST');",
              "    pm.expect(body.downloadRules).to.eql(['bat', 'exe']);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          }
        ],
        "url": "{{baseUrl}}/policies/{{adminPolicyId}}"
      }
    },
    {
      "name": "Listar Device ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ADMIN lista los dispositivos de su Company', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.items).to.be.an('array').and.not.empty;",
              "    body.items.forEach(d => pm.expect(d.companyId).to.eql(Number(pm.collectionVariables.get('demoCompanyId'))));",
              "    const demo = body.items.find(d => d.deviceIdentifier === 'b7eacb45-4aba-4a5a-8c0c-633a61294af1');",
              "    pm.expect(demo).to.be.an('object');",
              "    pm.collectionVariables.set('demoDeviceId', demo.id);",
              "});"
