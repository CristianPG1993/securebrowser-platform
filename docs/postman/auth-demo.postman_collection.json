    {
      "name": "Filtrar Device inactivos USER",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La instalación demo activa no aparece al filtrar inactivos', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.items).to.be.an('array');",
              "    body.items.forEach(d => {",
