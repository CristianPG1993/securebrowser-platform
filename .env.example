# Plantilla local; no se carga automáticamente al ejecutar Spring Boot desde Maven.
# Docker Compose sí carga el .env de la raíz; su conexión a PostgreSQL usa la red interna.
# Puerto publicado en 127.0.0.1: usar 8081 localmente si 8080 está ocupado.
SBP_HTTP_PORT=8080
SBP_DB_URL=jdbc:postgresql://127.0.0.1:5432/securebrowser_db
SBP_DB_USERNAME=sbp_app
SBP_DB_PASSWORD=
SBP_JWT_SECRET_BASE64=
SBP_JWT_ISSUER=securebrowser-backend
SBP_JWT_AUDIENCE=securebrowser-api
SBP_JWT_MAX_LIFETIME_SECONDS=900
SBP_REFRESH_TOKEN_LIFETIME_SECONDS=604800
# Solo necesarias al activar el perfil demo; Compose lo activa explícitamente.
# Cada contraseña requiere al menos 12 caracteres y como máximo 72 bytes UTF-8.
SBP_DEMO_ADMIN_PASSWORD=
SBP_DEMO_USER_PASSWORD=
